# ---- AI Filmmaking Studio (Phase 0, localhost) ----
# This is a template. Copy it to `.env` (which is gitignored) and fill in values.

# Node environment
NODE_ENV=development

# SQLite database file path (relative to the project root).
DATABASE_URL="file:./dev.db"

# Session cookie secret: MUST be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Single-user login passcode (change this). The one local user logs in with it.
AUTH_PASSCODE="frameforge"

# Owner email used to create/find the single local user.
OWNER_EMAIL="owner@local"

# Optional: default local media folder for assets (absolute or relative to project root).
MEDIA_DEFAULT_ROOT="./media"

# (Future) key for encrypting provider API keys at rest. Not used in Phase 0.
APP_ENCRYPTION_KEY=""
